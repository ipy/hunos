{
  "name": "hunos",
  "version": "1.0.0",
  "private": true,
  "description": "A beautiful, graph-aware note-taking app",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --port 5176 --strictPort",
    "build": "tsc && vite build",
    "build:harmony": "vite build --config vite.config.harmony.ts",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "chrome:e2e": "bash scripts/chrome-e2e.sh",
    "test:e2e": "node e2e/resolve-runtime.mjs && playwright test",
    "test:e2e:web": "E2E_RUNTIME=web node e2e/resolve-runtime.mjs && playwright test",
    "test:e2e:harmony": "E2E_RUNTIME=harmony node e2e/resolve-runtime.mjs && playwright test",
    "test:e2e:ui": "node e2e/resolve-runtime.mjs && playwright test --ui",
    "harmony:e2e:install": "bash harmony/scripts/e2e-install.sh",
    "harmony:e2e:forward": "bash harmony/scripts/e2e-cdp-forward.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/noto-serif": "^5.2.9",
    "@fontsource/source-code-pro": "^5.2.7",
    "@fontsource/source-sans-3": "^5.2.9",
    "@tiptap/extension-code-block-lowlight": "^2.8.0",
    "@tiptap/extension-highlight": "^2.8.0",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.8.0",
    "@tiptap/extension-placeholder": "^2.8.0",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.8.0",
    "@tiptap/extension-task-list": "^2.8.0",
    "@tiptap/extension-underline": "^2.8.0",
    "@tiptap/pm": "^2.8.0",
    "@tiptap/react": "^2.8.0",
    "@tiptap/starter-kit": "^2.8.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^23.15.1",
    "lowlight": "^3.1.0",
    "marked": "^18.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.0.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/marked": "^6.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.52.0"
  }
}
